{
  "expo": {
    "name": "Elexify",
    "slug": "elexify-mobile",
    "version": "0.1.0",
    "scheme": "elexify",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.elexify"
    },
    "android": {
      "package": "com.elexify",
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
