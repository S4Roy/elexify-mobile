{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/api/**/*.ts",
    "src/theme/**/*.ts",
    "src/platform/**/*.ts",
    "src/stores/**/*.ts",
    "src/providers/**/*.tsx",
    "tests/**/*.ts",
    "App.tsx",
    "src/features/**/*.ts",
    "src/features/**/*.tsx",
    "src/components/shop/**/*.tsx",
    "src/components/ui/**/*.tsx"
  ]
}
