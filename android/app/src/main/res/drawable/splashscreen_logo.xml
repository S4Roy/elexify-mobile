<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon (core-splashscreen back-ports it to older
     versions). A vector with a fixed 288x288dp canvas, as the SplashScreen
     API expects (content inside the central 192dp circle); a bitmap here is
     stretched to the icon area instead. The path is the Ionicons "flash"
     glyph — the same bolt AnimatedSplash draws — 120dp tall and centred, so
     the native-to-JS handoff lines up exactly. -->
